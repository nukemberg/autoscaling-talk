{
  "name": "autoscaling-talk",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "slidev build",
    "dev": "slidev --open",
    "export": "slidev export",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p sim && tsc --noEmit -p bench",
    "bench": "vite --config bench/vite.config.ts",
    "bench:build": "vite build --config bench/vite.config.ts",
    "build:site": "npm run build && rm -f dist/_redirects && npm run bench:build && rm -rf dist/workbench && mv dist-bench dist/workbench",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev"
  },
  "dependencies": {
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-default": "latest",
    "@slidev/theme-seriph": "latest",
    "qrcode": "^1.5.4",
    "uplot": "^1.6.32",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.2"
  }
}
